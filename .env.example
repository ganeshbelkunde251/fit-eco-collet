# EcoCollect Environment Configuration Template

# Application
APP_NAME=EcoCollect
APP_ENV=local
APP_URL=http://localhost/ecocollect

# Database Configuration (XAMPP default)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ecocollect
DB_USER=root
DB_PASSWORD=

# Google Gemini API Key
# Replace with your actual Gemini API key from Google AI Studio
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
